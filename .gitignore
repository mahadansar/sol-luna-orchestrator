# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output (generated by `npm run build`)
dist/
*.tsbuildinfo

# Runtime diagnostics from SOL_LUNA_LOG / SOL_LUNA_EVENTS
*.log
logs/
orchestrator.log
*.events.jsonl

# Per-task worktrees created for parallel batches. Also added to
# .git/info/exclude at runtime, so this is belt and braces.
.sol-luna/

# Benchmark output. Committed results are bench/results/*.json and their
# generated *.md summaries; raw per-run event streams are not.
bench/results/*.events.jsonl

# Environment and credentials. The example config is committed deliberately
# (examples/codex-config.toml) and contains no secrets.
.env
.env.*
!.env.example
*.pem
*.key
.npmrc
.netrc

# Caches and coverage
.cache/
.npm/
coverage/
.nyc_output/
*.lcov

# Editor and OS metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
